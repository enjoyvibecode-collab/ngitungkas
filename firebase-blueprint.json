{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and organization membership information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "treasurer", "staff", "student"] },
        "orgId": { "type": "string" },
        "assignedGrade": { "type": "number", "description": "Specific grade level this staff manages (7, 8, 9)" },
        "cashOnHand": { "type": "number", "description": "Current physical money held by this staff member" },
        "className": { "type": "string" },
        "nisn": { "type": "string" },
        "parentPhone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "orgId", "role"]
    },
    "OperationalTransfer": {
      "title": "Operational Fund Transfer",
      "description": "Record of funds transferred between Treasurer and Staff.",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["topup", "settlement"] },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromId", "toId", "amount", "type"]
    },
    "Transaction": {
      "title": "Cash Transaction",
      "description": "Record of income or expense for an organization.",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "className": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "approvedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["amount", "type", "description", "createdBy"]
    },
    "SavingAccount": {
      "title": "Saving Account",
      "description": "Current balance of an individual member's savings within an organization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "pendingWithdrawal": { "type": "boolean" },
        "pendingAmount": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance"]
    },
    "SavingLog": {
      "title": "Saving Log",
      "description": "Audit trail for every deposit or withdrawal in a saving account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "prevBalance": { "type": "number" },
        "newBalance": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["userId", "amount", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records."
    },
    "/organizations/{orgId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "Organization ledger entries."
    },
    "/organizations/{orgId}/savings/{userId}": {
      "schema": "SavingAccount",
      "description": "Current balances for member savings."
    },
    "/organizations/{orgId}/savings_logs/{logId}": {
      "schema": "SavingLog",
      "description": "Audit trail for all savings operations."
    },
    "/organizations/{orgId}/operational_transfers/{transferId}": {
      "schema": "OperationalTransfer",
      "description": "Ledger for funds distribution to staff."
    }
  }
}
