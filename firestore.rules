rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      // Basic check: must be signed in. Email verification is ideal but sometimes Google returns false for newly created accounts in certain regions or configurations.
      return isSignedIn(); 
    }
    
    // Relational Helpers
    function getProfile() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data : null;
    }
    function isOrgMember(orgId) {
      let p = getProfile();
      return isSignedIn() && p != null && p.orgId != null && p.orgId == orgId;
    }
    function isAdmin(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.role == 'admin';
    }
    function isTreasurer(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.role == 'treasurer';
    }
    function isTeacher(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.role == 'teacher';
    }
    function isFinanceRole(orgId) {
      return isAdmin(orgId) || isTreasurer(orgId);
    }
    function isAdministrativeRole(orgId) {
      return isFinanceRole(orgId) || isTeacher(orgId);
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUserSchema(data) {
        return (data.displayName is string && data.displayName.size() <= 100) &&
               (data.email is string) &&
               (data.role in ['admin', 'treasurer', 'teacher', 'member']) &&
               (data.orgId == null || (data.orgId is string && data.orgId.size() <= 64)) &&
               (data.className == null || (data.className is string && data.className.size() <= 20)) &&
               (data.nisn == null || (data.nisn is string && data.nisn.size() <= 30)) &&
               (data.phone == null || (data.phone is string && data.phone.size() <= 20)) &&
               (data.parentPhone == null || (data.parentPhone is string && data.parentPhone.size() <= 20));
      }

      // Allow users to read their own profile
      allow get: if isSignedIn() && (request.auth.uid == userId);
      
      // Allow members of the same org to see each other
      allow get: if isSignedIn() && (resource != null && isOrgMember(resource.data.orgId));
      allow list: if isSignedIn() && (request.query.limit > 0); 
      
      allow create: if isSignedIn() && (
        // Case 1: Self-registration
        (request.auth.uid == userId && isValidUserSchema(incoming()) && incoming().uid == userId) ||
        // Case 2: Administrative creation (e.g. Bulk Import)
        (isFinanceRole(incoming().orgId) && incoming().role == 'member' && isValidUserSchema(incoming()))
      );
      
      allow update: if isSignedIn() && isValidUserSchema(incoming()) && (
        // Case 1: User updating their own profile
        (request.auth.uid == userId && (
          // Students/Teachers can update personal info, but NOT role/orgId
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'parentPhone', 'className', 'nisn']) ||
          // First-time setup
          (existing().orgId == null && incoming().role in ['admin', 'member'] && incoming().orgId != null)
        )) ||
        // Case 2: Administrative Updates (Other Users)
        (
          resource != null && request.auth.uid != userId && 
          isOrgMember(resource.data.orgId) &&
          (
            // ADMIN: Full control except immutable system keys
            (isAdmin(resource.data.orgId) && 
             incoming().diff(existing()).affectedKeys().hasAny(['uid', 'email']) == false) ||
            
            // TREASURER/FINANCE: Management of data but not roles/org
            (isFinanceRole(resource.data.orgId) && 
             incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'parentPhone', 'photoURL', 'nisn', 'className']) &&
             incoming().role == existing().role && incoming().orgId == existing().orgId) ||
            
            // TEACHER: Classmates only.
            (isTeacher(resource.data.orgId) && 
             existing().className == getProfile().className &&
             incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'parentPhone', 'className', 'nisn', 'photoURL']) &&
             incoming().role == existing().role && incoming().orgId == existing().orgId)
          )
        )
      );
    }

    // 2. Organization subcollections
    match /organizations/{orgId} {
      allow get, create: if isSignedIn();

      // Transactions
      match /transactions/{txId} {
        function isValidTransaction(data) {
          return data.amount is number && data.amount >= 0 &&
                 data.type in ['income', 'expense'] &&
                 (data.title is string || data.description is string) &&
                 data.createdBy == request.auth.uid;
        }

        allow read: if isOrgMember(orgId);
        allow create: if isAdministrativeRole(orgId) && isValidId(txId) && isValidTransaction(incoming());
        allow update: if isAdministrativeRole(orgId) && isValidTransaction(incoming());
      }

      // Savings
      match /savings/{userId} {
        function isValidSaving(data) {
          return data.userId is string && data.balance is number;
        }

        allow get: if isOrgMember(orgId) && (request.auth.uid == userId || isAdministrativeRole(orgId));
        allow list: if isAdministrativeRole(orgId);
        allow write: if isAdministrativeRole(orgId) && isValidSaving(incoming());
      }

      // Activity Logs
      match /activity_logs/{logId} {
        function isValidActivityLog(data) {
          return data.actorId == request.auth.uid &&
                 data.orgId == orgId &&
                 data.action in ['promote', 'demote', 'remove', 'role_change', 'savings', 'transaction', 'contribution', 'reminder_sent'];
        }

        allow read: if isOrgMember(orgId);
        allow create: if isAdministrativeRole(orgId) && isValidActivityLog(incoming());
      }

      // Savings Logs
      match /savings_logs/{logId} {
        function isValidLog(data) {
          return data.userId is string &&
                 data.type in ['deposit', 'withdraw'] &&
                 data.amount is number && 
                 data.createdBy == request.auth.uid;
        }

        allow read: if isOrgMember(orgId) && (request.auth.uid == resource.data.userId || isAdministrativeRole(orgId));
        allow create: if isAdministrativeRole(orgId) && isValidLog(incoming());
      }
      
      // Contributions (Future use or explicit request)
      match /contributions/{userId} {
        allow read: if isOrgMember(orgId);
        allow write: if isFinanceRole(orgId);
      }

      // Billing Types (Master Tagihan)
      match /billing_types/{billId} {
        allow read: if isOrgMember(orgId);
        allow write: if isFinanceRole(orgId) && isValidId(billId);
      }

      // Student Bills (Individual Tagihan per Siswa)
      match /student_bills/{docId} {
        allow read: if isOrgMember(orgId) && (resource == null || request.auth.uid == resource.data.studentId || isAdministrativeRole(orgId));
        allow list: if isOrgMember(orgId);
        allow write: if isFinanceRole(orgId);
      }

      // Payment Logs (Riwayat Pembayaran Tagihan)
      match /payment_logs/{logId} {
        allow read: if isOrgMember(orgId);
        allow create: if isFinanceRole(orgId) && isValidId(logId);
      }
    }
  }
}
