rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny - Global Safety Net (Pillar 0)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // ID Poisoning Guard (Pillar 3)
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Relational Helpers - Hardened
    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isOrgMember(orgId) {
      let p = getProfile();
      return isSignedIn() && p != null && p.orgId == orgId;
    }
    
    function isAdmin(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.get('role', 'member') == 'admin';
    }
    
    function isTreasurer(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.get('role', 'member') == 'treasurer';
    }
    
    function isTeacher(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && (p.get('role', 'member') == 'teacher' || p.get('role', 'member') == 'staff');
    }

    function isFinanceRole(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && (p.get('role', 'member') == 'admin' || p.get('role', 'member') == 'treasurer');
    }

    function isAdministrativeRole(orgId) {
      let p = getProfile();
      let role = p.get('role', 'member');
      return isOrgMember(orgId) && (role == 'admin' || role == 'treasurer' || role == 'teacher' || role == 'staff' || role == 'class_treasurer');
    }

    // 1. Users Collection - Identity Integrity (Pillar 2, 6)
    match /users/{userId} {
      function isValidUser(data) {
        return (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
               (data.get('email', '') is string) &&
               (data.get('role', 'member') in ['admin', 'treasurer', 'staff', 'class_treasurer', 'member']) &&
               (data.get('orgId', null) == null || isValidId(data.get('orgId', ''))) &&
               (data.get('uid', '') == userId);
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isOrgMember(resource.data.get('orgId', null)));
      
      // Secure List Queries (Pillar 8)
      allow list: if (
        (isSignedIn() && (
          // Discovery: User searches for their own email (manual registration)
          (resource.data.email == request.auth.token.email) ||
          // Regular Org Listing
          (request.query.limit <= 500 && resource.data.orgId != null)
        )) || 
        // Public NISN Lookup (limit to single result)
        (request.query.limit <= 1 && resource.data.nisn != null)
      );
      
      allow create: if isSignedIn() && isValidUser(incoming()) && (
        (request.auth.uid == userId) ||
        (isAdministrativeRole(incoming().get('orgId', '')))
      );
      
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        // Self Update - Restricted Fields (Pillar 4)
        (request.auth.uid == userId && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'parentPhone', 'className', 'nisn', 'claimedAt', 'isManualCreated', 'orgName', 'orgId', 'role']) ||
          (existing().get('orgId', null) == null && incoming().get('orgId', null) != null)
        )) ||
        // Admin Update
        (isAdministrativeRole(resource.data.get('orgId', '')) && 
         incoming().diff(existing()).affectedKeys().hasAny(['uid', 'email']) == false)
      );

      allow delete: if isSignedIn() && (
        isAdmin(resource.data.get('orgId', '')) || 
        (resource.data.get('isManualCreated', false) == true && resource.data.email == request.auth.token.email)
      );
    }

    // 2. Organizations & Subcollections - Relational Sync (Pillar 1)
    match /organizations/{orgId} {
      allow get: if true; 
      allow create: if isSignedIn() && isValidId(orgId);
      
      // Transactions
      match /transactions/{txId} {
        function isValidTransaction(data) {
          return data.amount is number && data.amount >= 0 &&
                 data.type in ['income', 'expense'] &&
                 (data.get('description', '') is string && data.get('description', '').size() <= 1000) &&
                 (data.get('orgId', '') == orgId) &&
                 (data.get('status', 'approved') in ['pending', 'approved']);
        }

        allow get: if isOrgMember(orgId);
        allow list: if isOrgMember(orgId);
        
        allow create: if isAdministrativeRole(orgId) && 
                         isValidId(txId) && 
                         isValidTransaction(incoming()) &&
                         incoming().createdBy == request.auth.uid;
                         
        allow update: if isAdministrativeRole(orgId) && 
                         isValidTransaction(incoming()) && (
                           (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'updatedAt']) && isFinanceRole(orgId)) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'updatedAt', 'updatedBy', 'description', 'category', 'amount', 'type', 'className', 'status', 'approvedBy']))
                         );
      }

      // Savings
      match /savings/{userId} {
        allow get: if true;
        allow list: if isAdministrativeRole(orgId);
        allow write: if isAdministrativeRole(orgId) && incoming().userId == userId;
      }

      // Activity Logs
      match /activity_logs/{logId} {
        allow read: if isOrgMember(orgId);
        allow create: if isAdministrativeRole(orgId) && incoming().actorId == request.auth.uid;
      }

      // Savings Logs
      match /savings_logs/{logId} {
        allow list: if isOrgMember(orgId) || resource.data.userId != null;
        allow get: if isOrgMember(orgId) || true;
        allow create: if isAdministrativeRole(orgId) && incoming().createdBy == request.auth.uid;
      }

      match /billing_types/{billId} {
        allow read: if isOrgMember(orgId);
        allow write: if isFinanceRole(orgId);
      }

      match /student_bills/{docId} {
        allow list: if isOrgMember(orgId) || resource.data.studentId != null;
        allow get: if isOrgMember(orgId) || true;
        allow write: if isFinanceRole(orgId);
      }

      match /payment_logs/{logId} {
        allow list: if isOrgMember(orgId) && request.query.limit <= 100;
        allow get: if isOrgMember(orgId);
        allow create: if isFinanceRole(orgId);
      }
    }
  }
}

