rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      // Basic check: must be signed in. Email verification is ideal but sometimes Google returns false for newly created accounts in certain regions or configurations.
      return isSignedIn(); 
    }
    
    // Relational Helpers
    function getProfile() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data : null;
    }
    function isOrgMember(orgId) {
      let p = getProfile();
      return isSignedIn() && p != null && p.orgId != null && p.orgId == orgId;
    }
    function isOrgAdmin(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.role == 'admin';
    }
    function isOrgTreasurer(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && (p.role == 'admin' || p.role == 'treasurer');
    }

    function isOrgTeacher(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && (p.role == 'admin' || p.role == 'treasurer' || p.role == 'teacher');
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUserSchema(data) {
        return (data.displayName is string && data.displayName.size() <= 100) &&
               (data.email is string) &&
               (data.role in ['admin', 'treasurer', 'teacher', 'member']) &&
               (data.orgId == null || (data.orgId is string && data.orgId.size() <= 64)) &&
               (data.className == null || (data.className is string && data.className.size() <= 20)) &&
               (data.nisn == null || (data.nisn is string && data.nisn.size() <= 30)) &&
               (data.phone == null || (data.phone is string && data.phone.size() <= 20)) &&
               (data.parentPhone == null || (data.parentPhone is string && data.parentPhone.size() <= 20));
      }

      // Allow users to read their own profile
      allow get: if isSignedIn() && (request.auth.uid == userId);
      
      // Allow members of the same org to see each other
      allow get: if isSignedIn() && (resource != null && isOrgMember(resource.data.orgId));
      allow list: if isSignedIn() && (request.query.limit > 0); // Broad list allowed, filtered by query
      
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserSchema(incoming()) && incoming().uid == userId;
      
      allow update: if isSignedIn() && isValidUserSchema(incoming()) && (
        // Case 1: User updating their own profile
        (request.auth.uid == userId && (
          // Students/Teachers can update personal info, but NOT role/orgId
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'parentPhone', 'className', 'nisn']) ||
          // First-time setup
          (existing().orgId == null && incoming().role in ['admin', 'member'] && incoming().orgId != null)
        )) ||
        // Case 2: Administrative Updates (Other Users)
        (
          resource != null && request.auth.uid != userId && 
          isOrgMember(resource.data.orgId) &&
          (
            // ADMIN: Full control except immutable system keys
            (isOrgAdmin(resource.data.orgId) && 
             incoming().diff(existing()).affectedKeys().hasAny(['uid', 'email']) == false) ||
            
            // TREASURER: Finance + Contact info. NO role/orgId/className.
            (isOrgTreasurer(resource.data.orgId) && 
             incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'parentPhone', 'photoURL', 'nisn']) &&
             incoming().role == existing().role && incoming().orgId == existing().orgId) ||
            
            // TEACHER: Classmates only. Can edit student details.
            (getProfile().role == 'teacher' && 
             existing().className == getProfile().className &&
             incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'parentPhone', 'className', 'nisn', 'photoURL']) &&
             incoming().role == existing().role && incoming().orgId == existing().orgId)
          )
        )
      );
    }

    // 2. Organization subcollections
    match /organizations/{orgId} {
      // Allow any signed-in user to check if an organization exists (needed for joining)
      // but keep transactions private.
      allow get: if isSignedIn(); 
      allow create: if isSignedIn();

      // Transactions
      match /transactions/{txId} {
        function isValidTransaction(data) {
          return data.amount is number && data.amount > 0 &&
                 data.type in ['income', 'expense'] &&
                 data.description is string && data.description.size() <= 1000 &&
                 data.createdBy == request.auth.uid &&
                 data.isDeleted is bool;
        }

        allow read: if isOrgMember(orgId);
        allow create: if isOrgTeacher(orgId) && isValidId(txId) && isValidTransaction(incoming());
        allow update: if isOrgTeacher(orgId) && 
                         isValidTransaction(incoming()) &&
                         // Soft delete or field update tracking
                         (incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'updatedAt', 'updatedBy', 'category', 'description', 'amount']));
      }

      // Savings
      match /savings/{userId} {
        function isValidSaving(data) {
          return data.userId is string && 
                 data.balance is number &&
                 (data.name == null || data.name is string);
        }

        allow get: if isOrgMember(orgId) && (request.auth.uid == userId || isOrgTeacher(orgId));
        allow list: if isOrgTeacher(orgId);
        
        allow write: if isOrgTeacher(orgId) && isValidSaving(incoming());
      }

      // Activity Logs
      match /activity_logs/{logId} {
        function isValidActivityLog(data) {
          return data.actorId == request.auth.uid &&
                 data.timestamp == request.time &&
                 data.action in ['promote', 'demote', 'remove', 'role_change', 'savings', 'transaction', 'contribution', 'reminder_sent'] &&
                 data.orgId == orgId;
        }

        allow read: if isOrgMember(orgId);
        allow create: if isOrgTeacher(orgId) && isValidActivityLog(incoming());
      }

      // Savings Logs
      match /savings_logs/{logId} {
        function isValidLog(data) {
          return data.userId is string &&
                 data.type in ['deposit', 'withdraw'] &&
                 data.amount is number && 
                 data.createdBy == request.auth.uid;
        }

        allow read: if isOrgMember(orgId) && (request.auth.uid == resource.data.userId || isOrgTeacher(orgId));
        allow create: if isOrgTeacher(orgId) && isValidLog(incoming());
      }
    }
  }
}
