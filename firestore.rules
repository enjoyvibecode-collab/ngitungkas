rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      // Basic check: must be signed in. Email verification is ideal but sometimes Google returns false for newly created accounts in certain regions or configurations.
      return isSignedIn(); 
    }
    
    // Relational Helpers
    function getProfile() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data : null;
    }
    function isOrgMember(orgId) {
      let p = getProfile();
      return isSignedIn() && p != null && p.orgId != null && p.orgId == orgId;
    }
    function isOrgAdmin(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && p.role == 'admin';
    }
    function isOrgTreasurer(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && (p.role == 'admin' || p.role == 'treasurer');
    }

    function isOrgTeacher(orgId) {
      let p = getProfile();
      return isOrgMember(orgId) && (p.role == 'admin' || p.role == 'treasurer' || p.role == 'teacher');
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.email is string &&
               data.role in ['admin', 'treasurer', 'teacher', 'member'] &&
               (data.orgId == null || (data.orgId is string && data.orgId.size() <= 64)) &&
               (data.className == null || data.className is string) &&
               (data.nisn == null || data.nisn is string) &&
               (data.parentPhone == null || data.parentPhone is string);
      }

      // Allow users to read their own profile
      allow get: if isSignedIn() && (request.auth.uid == userId);
      
      // Allow members of the same org to see each other
      allow get: if isSignedIn() && (resource != null && isOrgMember(resource.data.orgId));
      allow list: if isOrgMember(request.query.limit > 0 ? getProfile().orgId : 'none'); // Simplified for list
      
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      
      allow update: if isSignedIn() && (
        // Case 1: User updating their own profile
        (request.auth.uid == userId && (
          // Normal updates
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'className', 'nisn', 'parentPhone']) ||
          // First-time setup
          (existing().orgId == null && incoming().role in ['admin', 'member'] && incoming().orgId != null)
        )) ||
        // Case 2: Admin/Treasurer managing other members
        (
          resource != null && 
          isOrgTreasurer(resource.data.orgId) && 
          request.auth.uid != userId && 
          // They can update more fields for students
          incoming().diff(existing()).affectedKeys().hasAll(['role']) == false && 
          (isOrgAdmin(resource.data.orgId) || incoming().role == existing().role)
        )
      );
    }

    // 2. Organization subcollections
    match /organizations/{orgId} {
      // Allow any signed-in user to check if an organization exists (needed for joining)
      // but keep transactions private.
      allow get: if isSignedIn(); 
      allow create: if isSignedIn();

      // Transactions
      match /transactions/{txId} {
        function isValidTransaction(data) {
          return data.amount is number && data.amount > 0 &&
                 data.type in ['income', 'expense'] &&
                 data.description is string && data.description.size() <= 1000 &&
                 data.createdBy == request.auth.uid &&
                 data.isDeleted is bool;
        }

        allow read: if isOrgMember(orgId);
        allow create: if isOrgTeacher(orgId) && isValidId(txId) && isValidTransaction(incoming());
        allow update: if isOrgTeacher(orgId) && 
                         isValidTransaction(incoming()) &&
                         // Soft delete or field update tracking
                         (incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'updatedAt', 'updatedBy', 'category', 'description', 'amount']));
      }

      // Savings
      match /savings/{userId} {
        function isValidSaving(data) {
          return data.userId is string && data.userId.size() <= 128 &&
                 data.balance is number;
        }

        allow get: if isVerified() && (request.auth.uid == userId || isOrgTeacher(orgId));
        allow list: if isOrgTeacher(orgId);
        
        allow write: if isOrgTeacher(orgId) && isValidSaving(incoming());
      }

      // Activity Logs
      match /activity_logs/{logId} {
        function isValidActivityLog(data) {
          return data.actorId == request.auth.uid &&
                 data.timestamp == request.time &&
                 data.action in ['promote', 'demote', 'remove', 'role_change'] &&
                 data.orgId == orgId;
        }

        allow read: if isOrgMember(orgId);
        allow create: if isOrgAdmin(orgId) && isValidActivityLog(incoming());
      }

      // Savings Logs
      match /savings_logs/{logId} {
        function isValidLog(data) {
          return data.userId is string &&
                 data.type in ['deposit', 'withdraw'] &&
                 data.amount is number && 
                 data.createdBy == request.auth.uid;
        }

        allow read: if isVerified() && (request.auth.uid == resource.data.userId || isOrgTeacher(orgId));
        allow create: if isOrgTeacher(orgId) && isValidLog(incoming());
      }
    }
  }
}
