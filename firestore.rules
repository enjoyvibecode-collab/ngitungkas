rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      // Basic check: must be signed in. Email verification is ideal but sometimes Google returns false for newly created accounts in certain regions or configurations.
      return isSignedIn(); 
    }
    
    // Relational Helpers
    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isOrgMember(orgId) {
      return isSignedIn() && getProfile().orgId == orgId;
    }
    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && getProfile().role == 'admin';
    }
    function isOrgTreasurer(orgId) {
      return isOrgMember(orgId) && (getProfile().role == 'admin' || getProfile().role == 'treasurer');
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.email is string &&
               data.role in ['admin', 'treasurer', 'member'] &&
               (data.orgId == null || (data.orgId is string && data.orgId.size() <= 50));
      }

      // Allow users to read their own profile - AVOID HELPERS HERE to prevent recursion
      allow get: if isSignedIn() && (request.auth.uid == userId);
      
      // Allow members to see other members in the same org
      // We use a direct lookup to avoid helper recursion
      allow get: if isSignedIn() && (resource != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.orgId);
      
      allow list: if isSignedIn() && resource.data.orgId != null && 
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == resource.data.orgId;
      
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && 
                       isValidUser(incoming()) && (
                         // Normal updates (role & orgId are immutable)
                         (incoming().role == existing().role && incoming().orgId == existing().orgId) ||
                         // First-time setup: Allow setting orgId and role to admin if currently null
                         (existing().orgId == null && incoming().role == 'admin' && incoming().orgId != null)
                       );
    }

    // 2. Organization subcollections
    match /organizations/{orgId} {
      allow get: if isOrgMember(orgId);
      allow create: if isSignedIn();

      // Transactions
      match /transactions/{txId} {
        function isValidTransaction(data) {
          return data.amount is number && data.amount > 0 &&
                 data.type in ['income', 'expense'] &&
                 data.description is string && data.description.size() <= 1000 &&
                 data.createdBy == request.auth.uid &&
                 data.isDeleted is bool;
        }

        allow read: if isOrgMember(orgId);
        allow create: if isOrgTreasurer(orgId) && isValidId(txId) && isValidTransaction(incoming());
        allow update: if isOrgTreasurer(orgId) && 
                         isValidTransaction(incoming()) &&
                         // Soft delete or field update tracking
                         (incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'updatedAt', 'updatedBy', 'category', 'description', 'amount']));
      }

      // Savings
      match /savings/{userId} {
        function isValidSaving(data) {
          return data.userId is string && data.userId.size() <= 128 &&
                 data.balance is number;
        }

        allow get: if isVerified() && (request.auth.uid == userId || isOrgTreasurer(orgId));
        allow list: if isOrgTreasurer(orgId);
        
        allow write: if isOrgTreasurer(orgId) && isValidSaving(incoming());
      }

      // Savings Logs
      match /savings_logs/{logId} {
        function isValidLog(data) {
          return data.userId is string &&
                 data.type in ['deposit', 'withdraw'] &&
                 data.amount is number && 
                 data.createdBy == request.auth.uid;
        }

        allow read: if isVerified() && (request.auth.uid == resource.data.userId || isOrgTreasurer(orgId));
        allow create: if isOrgTreasurer(orgId) && isValidLog(incoming());
      }
    }
  }
}
